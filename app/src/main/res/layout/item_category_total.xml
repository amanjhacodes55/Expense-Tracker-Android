<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">

    <View
        android:id="@+id/categoryDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_circle"
        app:layout_constraintBottom_toBottomOf="@id/categoryName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/categoryName"
        tools:backgroundTint="@color/category_food" />

    <TextView
        android:id="@+id/categoryName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        app:layout_constraintEnd_toStartOf="@id/categoryAmount"
        app:layout_constraintStart_toEndOf="@id/categoryDot"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Food" />

    <TextView
        android:id="@+id/categoryAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        app:layout_constraintBaseline_toBaselineOf="@id/categoryName"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="₹2,400.00" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/categoryProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/categoryName"
        app:trackCornerRadius="2dp"
        app:trackThickness="4dp"
        tools:progress="40" />

</androidx.constraintlayout.widget.ConstraintLayout>
